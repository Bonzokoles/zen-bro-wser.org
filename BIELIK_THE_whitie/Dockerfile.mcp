FROM node:20-alpine

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm ci || npm install

# Copy source and tsconfig
COPY . .

# Build TypeScript - use npm script that references tsconfig
RUN npm run build

# Expose MCP server port
EXPOSE 8788

# Start MCP server
CMD ["node", "dist/mcp-server.js"]
