---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Dashboard - ZENO Browser">
  <main
    class="min-h-screen bg-gradient-to-br from-slate-900 via-purple-900 to-slate-900 py-12 px-4"
  >
    <div class="max-w-6xl mx-auto">
      <!-- Header -->
      <div class="text-center mb-12">
        <h1 class="text-5xl font-bold text-white mb-4">
          Welcome to Your Dashboard
        </h1>
        <p class="text-xl text-purple-200">
          Manage your ZENO Browser subscription and API access
        </p>
      </div>

      <!-- Dashboard Grid -->
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3" id="dashboard-root">
        <!-- Loading state -->
        <div class="col-span-full text-center py-12">
          <div
            class="inline-block animate-spin rounded-full h-12 w-12 border-4 border-purple-500 border-t-transparent"
          >
          </div>
          <p class="text-white mt-4">Loading your dashboard...</p>
        </div>
      </div>

      <!-- Quick Links -->
      <div class="mt-12 grid gap-4 md:grid-cols-3">
        <a
          href="/pricing"
          class="block p-6 bg-white/10 rounded-xl hover:bg-white/20 transition-colors text-center"
        >
          <div class="text-3xl mb-2">💳</div>
          <h3 class="text-white font-semibold mb-1">Upgrade Plan</h3>
          <p class="text-purple-200 text-sm">View pricing options</p>
        </a>
        <a
          href="https://docs.zeno-browser.com"
          class="block p-6 bg-white/10 rounded-xl hover:bg-white/20 transition-colors text-center"
        >
          <div class="text-3xl mb-2">📚</div>
          <h3 class="text-white font-semibold mb-1">Documentation</h3>
          <p class="text-purple-200 text-sm">API reference & guides</p>
        </a>
        <a
          href="mailto:JimBoZen@proton.me"
          class="block p-6 bg-white/10 rounded-xl hover:bg-white/20 transition-colors text-center"
        >
          <div class="text-3xl mb-2">💬</div>
          <h3 class="text-white font-semibold mb-1">Support</h3>
          <p class="text-purple-200 text-sm">JimBoZen@proton.me</p>
        </a>
      </div>
    </div>
  </main>
</Layout>

<script>
  import { createRoot } from "react-dom/client";
  import { createElement } from "react";
  import DashboardContent from "../components/DashboardContent";

  const container = document.getElementById("dashboard-root");
  if (container) {
    const root = createRoot(container);
    root.render(createElement(DashboardContent));
  }
</script>
