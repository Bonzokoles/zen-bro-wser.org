---
import Layout from "../layouts/Layout.astro";
import SiteSearch from "../components/iframe/SiteSearch";
---

<Layout
  title="ZENO - Site Search Demo"
  description="Advanced site search with React"
>
  <div class="header" style="text-align: center; margin-bottom: 2rem;">
    <h1
      style="font-size: 3rem; font-weight: 800; margin-bottom: 1rem; background: linear-gradient(135deg, #60a5fa, #a78bfa); -webkit-background-clip: text; -webkit-text-fill-color: transparent;"
    >
      🔍 Advanced Site Search
    </h1>
    <p style="color: #94a3b8; font-size: 1.2rem;">
      Find iframe-testable sites with powerful filters
    </p>
  </div>
  <div class="search-container" style="padding: 0 2rem;">
    <SiteSearch
      client:load
      onSelectSite={(site) => {
        console.log("Selected site:", site);
        alert(`Selected: ${site.name}\nURL: ${site.url}`);
      }}
      enableFavorites={true}
      enableHistory={true}
      pageSize={15}
    />
  </div>
</Layout>
