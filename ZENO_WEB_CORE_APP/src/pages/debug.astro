---
import Layout from '../layouts/Layout.astro';
---

<Layout title="MCP Debug Page"
  description="Debug page for MCP service testing"
>
  <main className="container mx-auto p-8">
    <h1 className="text-3xl font-bold mb-4">MCP Service Debug Page</h1>
    <p className="mb-6">Use this page to test AI provider connections and chat functionality.</p>

    <div className="space-y-4">
      <div className="bg-gray-800 p-4 rounded-lg">
        <h2 className="text-xl font-semibold mb-2">Debug Console</h2>
        <p className="text-gray-400">Open browser console (F12) to see debug logs</p>
      </div>

      <div className="bg-gray-800 p-4 rounded-lg">
        <h2 className="text-xl font-semibold mb-2">Status</h2>
        <p className="text-green-400">System operational</p>
      </div>
    </div>
  </main>
</Layout>
<style is:global>
  body {
    background-color: #0f172a;
    color: #f1f5f9;
  }
</style>