---
// Success Page - Payment Successful
const searchParams = new URL(Astro.request.url).searchParams;
const sessionId = searchParams.get("session_id");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Payment Successful - ZENO Browser</title>
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto,
          sans-serif;
        background: linear-gradient(135deg, #10b981 0%, #059669 100%);
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem;
      }

      .container {
        background: white;
        border-radius: 16px;
        padding: 3rem;
        max-width: 600px;
        text-align: center;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
      }

      .success-icon {
        font-size: 5rem;
        margin-bottom: 1rem;
        animation: bounce 0.6s ease-in-out;
      }

      @keyframes bounce {
        0%,
        100% {
          transform: translateY(0);
        }
        50% {
          transform: translateY(-20px);
        }
      }

      h1 {
        font-size: 2.5rem;
        color: #10b981;
        margin-bottom: 1rem;
      }

      p {
        font-size: 1.125rem;
        color: #6b7280;
        margin-bottom: 2rem;
      }

      .session-id {
        background: #f3f4f6;
        padding: 1rem;
        border-radius: 8px;
        font-family: monospace;
        font-size: 0.875rem;
        margin-bottom: 2rem;
        word-break: break-all;
      }

      .button {
        display: inline-block;
        padding: 1rem 2rem;
        background: #10b981;
        color: white;
        text-decoration: none;
        border-radius: 8px;
        font-weight: bold;
        transition: background 0.2s;
        margin: 0.5rem;
      }

      .button:hover {
        background: #059669;
      }

      .button-secondary {
        background: #6b7280;
      }

      .button-secondary:hover {
        background: #4b5563;
      }

      .next-steps {
        margin-top: 2rem;
        text-align: left;
        background: #f9fafb;
        padding: 1.5rem;
        border-radius: 8px;
      }

      .next-steps h2 {
        font-size: 1.25rem;
        margin-bottom: 1rem;
        color: #1f2937;
      }

      .next-steps ol {
        margin-left: 1.5rem;
        color: #4b5563;
      }

      .next-steps li {
        margin-bottom: 0.5rem;
      }

      .api-key-section {
        background: #fffbeb;
        border: 2px solid #fbbf24;
        border-radius: 8px;
        padding: 1rem;
        margin: 1rem 0;
      }

      .api-key-section strong {
        color: #b45309;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <div class="success-icon">✅</div>
      <h1>Payment Successful!</h1>
      <p>
        Thank you for subscribing to ZENO Browser Pro. Your account has been
        upgraded.
      </p>

      {
        sessionId && (
          <div class="session-id">
            <>
              <strong>Session ID:</strong>
              <br />
            </>
            {sessionId}
          </div>
        )
      }

      <div class="api-key-section">
        <strong>🔑 Your API Key is being generated...</strong>
        <p style="margin-top: 0.5rem; margin-bottom: 0; font-size: 0.875rem;">
          Check your email for your API key and getting started guide.
        </p>
      </div>

      <div class="next-steps">
        <h2>📋 Next Steps</h2>
        <ol>
          <li>Check your email for confirmation and API key</li>
          <li>Save your API key securely (we'll only show it once)</li>
          <li>Visit the dashboard to start testing</li>
          <li>Read the API documentation for integrations</li>
          <li>Join our Discord community for support</li>
        </ol>
      </div>

      <div style="margin-top: 2rem;">
        <a href="/dashboard" class="button">Go to Dashboard</a>
        <a href="/analytics" class="button button-secondary">View Analytics</a>
      </div>

      <p style="margin-top: 2rem; font-size: 0.875rem; color: #9ca3af;">
        Having issues? <a href="/support" style="color: #10b981;"
          >Contact Support</a
        >
      </p>
    </div>

    <script>
      // Save session ID to localStorage for dashboard
      const urlParams = new URLSearchParams(window.location.search);
      const sessionId = urlParams.get("session_id");
      if (sessionId) {
        localStorage.setItem("zeno_session_id", sessionId);
        console.log("✅ Session ID saved:", sessionId);
      }
    </script>
  </body>
</html>
