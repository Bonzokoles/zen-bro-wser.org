---
/*
 * Admin Panel Page
 * Full admin interface for managing sites and users
 *
 * Features:
 * - Site CRUD operations
 * - User management
 * - Statistics dashboard
 * - Responsive design
 */
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Panel Administratora - ZENO Browser</title>
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto,
          "Helvetica Neue", Arial, sans-serif;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        min-height: 100vh;
        padding: 20px;
      }

      .container {
        max-width: 1200px;
        margin: 0 auto;
        background: white;
        border-radius: 12px;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.2);
        padding: 40px;
      }

      h1 {
        font-size: 2.5em;
        color: #667eea;
        text-align: center;
        margin-bottom: 10px;
      }

      .subtitle {
        text-align: center;
        color: #666;
        margin-bottom: 30px;
        font-size: 1.1em;
      }

      .stats-bar {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 20px;
        margin-bottom: 40px;
      }

      .stat-card {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 20px;
        border-radius: 8px;
        text-align: center;
      }

      .stat-value {
        font-size: 2.5em;
        font-weight: bold;
        display: block;
      }

      .stat-label {
        font-size: 0.9em;
        opacity: 0.9;
        margin-top: 5px;
      }

      #app {
        margin-top: 20px;
      }

      button {
        background: #667eea;
        color: white;
        border: none;
        padding: 8px 16px;
        border-radius: 4px;
        cursor: pointer;
        font-size: 14px;
        transition: background 0.2s;
      }

      button:hover {
        background: #5568d3;
      }

      input,
      textarea {
        width: 100%;
        border: 1px solid #ddd;
        border-radius: 4px;
      }

      input:focus,
      textarea:focus {
        outline: none;
        border-color: #667eea;
        box-shadow: 0 0 0 2px rgba(102, 126, 234, 0.2);
      }
    </style>
  </head>
  <body>
    <div class="container">
      <h1>🛡️ Panel Administratora</h1>
      <p class="subtitle">Zarządzanie stronami i użytkownikami</p>

      <div class="stats-bar">
        <div class="stat-card">
          <span class="stat-value" id="total-sites">0</span>
          <span class="stat-label">Wszystkich stron</span>
        </div>
        <div class="stat-card">
          <span class="stat-value" id="iframe-friendly">0</span>
          <span class="stat-label">Zgodnych z iframe</span>
        </div>
        <div class="stat-card">
          <span class="stat-value" id="total-users">0</span>
          <span class="stat-label">Użytkowników</span>
        </div>
        <div class="stat-card">
          <span class="stat-value" id="total-tests">0</span>
          <span class="stat-label">Wszystkich testów</span>
        </div>
      </div>

      <div id="app"></div>
    </div>

    <script>
      import React from "react";
      import { createRoot } from "react-dom/client";
      import { createElement } from "react";
      import { AdminPanel } from "../components/iframe/AdminPanel";
      import { InstructionsPanel, type Instruction } from "../components/InstructionsPanel";

      document.addEventListener("DOMContentLoaded", () => {
        // Mount React component
        const container = document.getElementById("app");
        if (container) {
          const root = createRoot(container);
          root.render(React.createElement(AdminPanel));
        }

        // Load statistics
        async function loadStats() {
          try {
            // Load sites stats
            const sitesRes = await fetch("/api/admin/sites");
            const sitesData = await sitesRes.json();

            if (sitesData.success) {
              const sites = sitesData.data;
              document.getElementById("total-sites")!.textContent =
                sites.length.toString();

              const iframeFriendly = sites.filter(
                (s: any) => s.iframeAllowed
              ).length;
              document.getElementById("iframe-friendly")!.textContent =
                iframeFriendly.toString();

              const totalTests = sites.reduce(
                (sum: number, s: any) => sum + (s.testCount || 0),
                0
              );
              document.getElementById("total-tests")!.textContent =
                totalTests.toString();
            }

            // Load users stats
            const usersRes = await fetch("/api/admin/users");
            const usersData = await usersRes.json();

            if (usersData.success) {
              document.getElementById("total-users")!.textContent =
                usersData.data.length.toString();
            }
          } catch (error) {
            console.error("Error loading stats:", error);
          }
        }

        loadStats();

        // Mount Instructions Panel
        const instructions: Instruction[] = [
          {
            step: 1,
            title: "Monitor Statistics",
            description: "View real-time dashboard showing total sites, iframe-friendly sites, active users, and total tests performed across the system."
          },
          {
            step: 2,
            title: "Manage Sites",
            description: "Add, edit, or remove test sites. Configure iframe settings, sandbox attributes, and categorize sites for better organization."
          },
          {
            step: 3,
            title: "User Administration",
            description: "Manage user accounts, permissions, and access levels. Monitor user activity and test history for audit purposes."
          },
          {
            step: 4,
            title: "Export & Reports",
            description: "Generate reports on site compatibility, test results, and system usage. Export data in various formats for analysis."
          }
        ];

        const instructionsContainer = document.createElement("div");
        document.body.appendChild(instructionsContainer);
        const instructionsRoot = createRoot(instructionsContainer);
        instructionsRoot.render(
          createElement(InstructionsPanel, {
            title: "Admin Panel Guide",
            instructions,
            defaultOpen: false
          })
        );
      });
    </script>
  </body>
</html>
