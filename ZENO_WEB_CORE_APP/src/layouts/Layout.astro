---
import { Toaster } from "../components/Toaster";

export interface Props {
  title: string;
  description?: string;
}

const { title, description = "ZENO Web Browser with MCP Integration" } =
  Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body class="animated-background">
    <div class="background-effects">
      <div class="gradient-layer"></div>
      <div class="particle-layer"></div>
      <div class="stars-layer"></div>
    </div>
    <slot />
    <Toaster client:load />
  </body>
</html>

<style>
  @import "../styles/global.css";

  /* Static grid background system */
  .animated-background {
    margin: 0;
    padding: 0;
    height: 100vh;
    overflow: visible;
    position: relative;
    background: #000000;
  }

  .background-effects {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    pointer-events: none;
  }

  /* Ensure content is above background */
  body > :not(.background-effects) {
    position: relative;
    z-index: 1;
  }

  /* Ensure all content and modals are above background */
  main,
  #root,
  [data-astro-root] {
    position: relative;
    z-index: 1;
  }

  /* Dark gradient layer - black to blue */
  .gradient-layer {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(
      135deg,
      #000000 0%,
      #0a0a1a 25%,
      #0f1729 50%,
      #1a1f3a 75%,
      #1e3a5f 100%
    );
  }

  /* Grid pattern layer */
  .particle-layer {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image: 
      /* Vertical lines */
      repeating-linear-gradient(
        90deg,
        transparent,
        transparent 49px,
        rgba(59, 130, 246, 0.15) 49px,
        rgba(59, 130, 246, 0.15) 50px
      ),
      /* Horizontal lines */
        repeating-linear-gradient(
          0deg,
          transparent,
          transparent 49px,
          rgba(59, 130, 246, 0.15) 49px,
          rgba(59, 130, 246, 0.15) 50px
        ),
      /* Thicker vertical lines every 200px */
        repeating-linear-gradient(
          90deg,
          transparent,
          transparent 199px,
          rgba(59, 130, 246, 0.3) 199px,
          rgba(59, 130, 246, 0.3) 201px
        ),
      /* Thicker horizontal lines every 200px */
        repeating-linear-gradient(
          0deg,
          transparent,
          transparent 199px,
          rgba(59, 130, 246, 0.3) 199px,
          rgba(59, 130, 246, 0.3) 201px
        );
    background-size:
      50px 50px,
      50px 50px,
      200px 200px,
      200px 200px;
  }

  /* Diagonal lines and accent elements */
  .stars-layer {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image: 
      /* Diagonal lines */
      repeating-linear-gradient(
        45deg,
        transparent,
        transparent 99px,
        rgba(147, 197, 253, 0.08) 99px,
        rgba(147, 197, 253, 0.08) 100px
      ),
      repeating-linear-gradient(
        -45deg,
        transparent,
        transparent 99px,
        rgba(147, 197, 253, 0.08) 99px,
        rgba(147, 197, 253, 0.08) 100px
      ),
      /* Subtle dots at grid intersections */
        radial-gradient(
          circle at 0% 0%,
          rgba(96, 165, 250, 0.4) 1px,
          transparent 1px
        );
    background-size:
      100px 100px,
      100px 100px,
      50px 50px;
  }

  /* Vignette effect */
  .particle-layer::after {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: radial-gradient(
      ellipse at center,
      transparent 0%,
      transparent 50%,
      rgba(0, 0, 0, 0.4) 100%
    );
  }
</style>
