---
import { Toaster } from "../components/Toaster";

export interface Props {
  title: string;
  description?: string;
}

const { title, description = "ZENO Web Browser with MCP Integration" } =
  Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;500;600;700;800;900&family=Share+Tech+Mono&display=swap" rel="stylesheet">

    <title>{title}</title>

    <!-- Analytics & Monitoring -->
    <script is:inline>
      // Zen Browser Analytics - Cloudflare Metrics Gateway
      (function() {
        const METRICS_BASE = 'https://zen-metrics-gateway.stolarnia-ams.workers.dev';

        function getSessionId() {
          let sessionId = sessionStorage.getItem('zen_session_id');
          if (!sessionId) {
            sessionId = crypto.randomUUID();
            sessionStorage.setItem('zen_session_id', sessionId);
          }
          return sessionId;
        }

        function trackPageView() {
          fetch(METRICS_BASE + '/metrics/track', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              type: 'pageview',
              data: {
                path: window.location.pathname,
                title: document.title,
                referrer: document.referrer,
                screenWidth: window.innerWidth,
                screenHeight: window.innerHeight
              },
              session: getSessionId(),
              timestamp: Date.now()
            })
          }).catch(() => {});
        }

        // Track na załadowanie strony
        if (document.readyState === 'complete') {
          trackPageView();
        } else {
          window.addEventListener('load', trackPageView);
        }

        // Expose dla innych komponentów
        window.zenTrack = function(type, data) {
          fetch(METRICS_BASE + '/metrics/track', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              type: type,
              data: data,
              session: getSessionId(),
              timestamp: Date.now()
            })
          }).catch(() => {});
        };
      })();
    </script>
  </head>
  <body class="zeno-background">
    <div class="background-effects"></div>
    <slot />
    <Toaster client:load />
  </body>
</html>

<style is:global>
  /* Global Styles & Background */
  :root {
    --dark-blue: #030712;
    --grid-line-color: rgba(59, 130, 246, 0.08);
    --grid-line-bold-color: rgba(59, 130, 246, 0.15);
  }

  body.zeno-background {
    margin: 0;
    padding: 0;
    height: 100vh;
    overflow-x: hidden; /* Prevent horizontal scroll */
    position: relative;
    background-color: #000;
    color: #f0f0f0;
    font-family: 'Share Tech Mono', monospace;
    font-style: italic;
  }

  .background-effects {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    pointer-events: none;
    background-image:
      /* 1. Vignette Effect */
      radial-gradient(
        ellipse at center,
        rgba(0, 0, 0, 0) 50%,
        rgba(0, 0, 0, 0.8) 100%
      ),
      /* 2. Subtle Grid Pattern */
        repeating-linear-gradient(
          0deg,
          transparent,
          transparent 49px,
          var(--grid-line-color) 49px,
          var(--grid-line-color) 50px
        ),
      repeating-linear-gradient(
        90deg,
        transparent,
        transparent 49px,
        var(--grid-line-color) 49px,
        var(--grid-line-color) 50px
      ),
      /* 3. Abstract Diagonal Lines */
        repeating-linear-gradient(
          -45deg,
          transparent,
          transparent 5px,
          rgba(24, 46, 82, 0.1) 5px,
          rgba(24, 46, 82, 0.1) 10px
        ),
      /* 4. Base Gradient */
        linear-gradient(165deg, #000000 0%, var(--dark-blue) 100%);
    background-size:
      100% 100%,
      50px 50px,
      50px 50px,
      100% 100%,
      100% 100%;
  }

  /* Ensure content is above the background */
  body > :not(.background-effects) {
    position: relative;
    z-index: 1;
  }

  /* Remove rounded corners and add hover effect */
  a,
  button,
  .card {
    border-radius: 0 !important; /* No rounded corners */
    transition:
      background-color 0.3s ease,
      box-shadow 0.3s ease,
      transform 0.2s ease;
  }

  a:hover,
  button:hover {
    background-color: rgba(59, 130, 246, 0.1); /* Subtle blue highlight */
    box-shadow: 0 0 15px rgba(59, 130, 246, 0.2);
    transform: translateY(-2px);
  }

  /* Pulse animation for icon */
  @keyframes pulse {
    0%, 100% {
      transform: scale(1);
      filter: drop-shadow(0 0 20px rgba(96, 165, 250, 0.5));
    }
    50% {
      transform: scale(1.05);
      filter: drop-shadow(0 0 30px rgba(96, 165, 250, 0.8));
    }
  }

  /* Backlight glow animation */
  @keyframes pulseGlow {
    0%, 100% {
      opacity: 0.6;
      transform: translate(-50%, -50%) scale(1);
    }
    50% {
      opacity: 1;
      transform: translate(-50%, -50%) scale(1.1);
    }
  }
</style>
