# CAYD Search Engine - Git Ignore

# Systemowe
.DS_Store
Thumbs.db
*.swp
*.swo

# Node
node_modules/
dist/
package-lock.json

# Logi i tymczasowe
*.log
*.tmp
abandoned.txt
crawled.txt

# Konfiguracje lokalne i hasła
.env
config/.env
config/my.cnf
config/servers.csv

# Compiled binaries (C/Go)
cr
rs
rt
core
1core
*.o
*.exe

# Database files
*.sql
*.db
robots/*
!robots/.gitkeep
mysql-data/
mysql-logs/

# PHP/Web
html/hash/
html/*/hashmake.php

# Backup files
backups/
*.backup
*.bak

# IDE
.vscode/
.idea/
*.sublime-*

# Nginx cache
phpcache/
cache/

# Temporary files
tmp/
temp/
