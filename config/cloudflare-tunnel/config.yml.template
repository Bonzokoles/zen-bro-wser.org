# ⚠️ TEMPLATE - Nie edytuj tego pliku bezpośrednio!
#
# Ten plik to SZABLON konfiguracji Cloudflare Tunnel
#
# UŻYCIE:
# 1. Uruchom: .\setup.ps1
#    → Automatycznie wygeneruje config.yml z poprawnymi wartościami
#
# 2. LUB skopiuj ten plik jako config.yml i zamień:
#    - {TUNNEL_NAME} → nazwa tunelu (np. zen-browser)
#    - {TUNNEL_ID} → ID tunelu (z: cloudflared tunnel list)
#    - {USER} → twoja nazwa użytkownika Windows
#    - {DOMAIN} → twoja domena (np. zen-bro-wser.org)
#
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Podstawowa konfiguracja tunelu
tunnel: {TUNNEL_NAME}
credentials-file: C:\Users\{USER}\.cloudflared\{TUNNEL_ID}.json

# Ingress rules - routing subdomen do lokalnych serwisów
ingress:
  # ┌─────────────────────────────────────────────────────┐
  # │  Frontend - Astro Development Server                │
  # └─────────────────────────────────────────────────────┘
  - hostname: zeno-app.{DOMAIN}
    service: http://localhost:5173
    originRequest:
      noTLSVerify: true
      connectTimeout: 30s
      disableChunkedEncoding: false

  # ┌─────────────────────────────────────────────────────┐
  # │  API Gateway - Cloudflare Workers (local dev)       │
  # └─────────────────────────────────────────────────────┘
  - hostname: api.{DOMAIN}
    service: http://localhost:8787
    originRequest:
      noTLSVerify: true
      connectTimeout: 10s

  # ┌─────────────────────────────────────────────────────┐
  # │  CAYD Search Engine                                 │
  # └─────────────────────────────────────────────────────┘
  - hostname: cayd.{DOMAIN}
    service: http://localhost:3000
    originRequest:
      noTLSVerify: true
      connectTimeout: 20s

  # ┌─────────────────────────────────────────────────────┐
  # │  Iframe Proxy Worker                                │
  # └─────────────────────────────────────────────────────┘
  - hostname: proxy.{DOMAIN}
    service: http://localhost:8080
    originRequest:
      noTLSVerify: true

  # ┌─────────────────────────────────────────────────────┐
  # │  Database Admin Panel (pgAdmin/Adminer)             │
  # └─────────────────────────────────────────────────────┘
  - hostname: db-admin.{DOMAIN}
    service: http://localhost:5432
    originRequest:
      noTLSVerify: true
      httpHostHeader: localhost:5432

  # ┌─────────────────────────────────────────────────────┐
  # │  AI Services Module (Bielik/Gemini)                 │
  # └─────────────────────────────────────────────────────┘
  - hostname: ai.{DOMAIN}
    service: http://localhost:8000
    originRequest:
      noTLSVerify: true

  # ┌─────────────────────────────────────────────────────┐
  # │  WebSocket Support (real-time features)             │
  # └─────────────────────────────────────────────────────┘
  - hostname: ws.{DOMAIN}
    service: http://localhost:3001
    originRequest:
      noTLSVerify: true

  # ┌─────────────────────────────────────────────────────┐
  # │  Catch-all Rule (WYMAGANE jako ostatnie!)           │
  # └─────────────────────────────────────────────────────┘
  - service: http_status:404

