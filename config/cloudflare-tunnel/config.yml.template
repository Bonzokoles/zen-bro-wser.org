#  NOTATKI
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#
# 1. Kolejność ingress rules ma znaczenie!
#    → Pierwsza pasująca reguła wygrywa
#    → Catch-all MUSI być ostatni
#
# 2. originRequest.noTLSVerify: true
#    → Wyłącza weryfikację SSL dla localhost
#    → Bezpieczne dla dev, NIE używaj w production z zewnętrznymi API
#
# 3. connectTimeout
#    → Jak długo czekać na odpowiedź od lokalnego serwisu
#    → Frontend (30s) > API (10s) > Static (5s)
#
# 4. httpHostHeader
#    → Nadpisuje header Host w request
#    → Użyteczne gdy backend sprawdza hostname
#
# 5. Testowanie reguł:
#    cloudflared tunnel ingress validate --config config.yml
#    cloudflared tunnel ingress rule https://api.{DOMAIN}
#
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
