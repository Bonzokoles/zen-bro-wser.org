{
  "mcpServers": {
    "zeno-browser": {
      "command": "node",
      "args": ["./mcp-server/dist/index.js"],
      "env": {
        "TAVILY_API_KEY": "${TAVILY_API_KEY}"
      },
      "description": "ZENO Browser MCP Server - provides web_search, navigate, scrape_page, take_screenshot, bookmark_manager, page_summarizer tools"
    },
    "zeno-filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "./"],
      "description": "Filesystem access for ZENO project"
    }
  }
}
