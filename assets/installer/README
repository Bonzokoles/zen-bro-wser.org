; INSTALLER ASSETS README
; =======================
;
; This directory contains assets for platform-specific installers.
;
; Required files:
; ---------------
; icon.ico              - Windows installer icon (256x256 ICO)
; icon.icns             - macOS application icon (ICNS bundle)
; dmg-background.png    - macOS DMG background image (540x380 PNG)
; entitlements.mac.plist- macOS code signing entitlements
; installer.nsh         - NSIS include file (macros)
; installer.nsi         - NSIS script (custom pages/logic)
;
; icons/                - Linux icon set (PNG files)
;   16x16.png
;   24x24.png
;   32x32.png
;   48x48.png
;   64x64.png
;   128x128.png
;   256x256.png
;   512x512.png
;
; How to generate icons from a single source image:
; --------------------------------------------------
; Install ImageMagick, then run:
;
;   # Generate .ico (Windows)
;   convert source.png -resize 256x256 icon.ico
;
;   # Generate .icns (macOS) using iconutil
;   mkdir MyIcon.iconset
;   for size in 16 32 64 128 256 512; do
;     convert source.png -resize ${size}x${size} MyIcon.iconset/icon_${size}x${size}.png
;   done
;   iconutil -c icns MyIcon.iconset -o icon.icns
;
;   # Generate Linux PNGs
;   for size in 16 24 32 48 64 128 256 512; do
;     convert source.png -resize ${size}x${size} icons/${size}x${size}.png
;   done
