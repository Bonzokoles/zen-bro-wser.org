{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "src/**/*", "ZENO_WEB_CORE_APP/src/**/*"],
  "exclude": [
    "dist",
    "NEWfiles",
    ".workspace_meta",
    "node_modules",
    "src-electron",
    "old_app",
    "ARCHIVES",
    "CAYD_SEARCH_ENG",
    "gemini-multi-modal-ai-suite",
    "BIELIK_THE_whitie",
    "DOCUMENTS_ALL",
    "INSTRUCTIONS_FOR_TRAINING",
    "LIBRARIES",
    "ZENO_WEB_CORE_APP/src/working"
  ],
  "compilerOptions": {
    "strictNullChecks": true,
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  }
}
