# ═══════════════════════════════════════════════════════════════════════════
# 🔐 ZENO Browser - API Keys Configuration (Development)
# ═══════════════════════════════════════════════════════════════════════════
#
# 📚 Complete guide: See API_CONFIGURATION_GUIDE.md
#
# 🚀 Quick Start:
# 1. Copy this file to `.env.local` (for local dev)
# 2. Fill in your API keys (get them from links below)
# 3. Restart dev server: npm run dev
#
# ⚠️  SECURITY: Never commit `.env.local` to Git (it's in .gitignore)
#
# ═══════════════════════════════════════════════════════════════════════════

# ───────────────────────────────────────────────────────────────────────────
# 📧 Contact Information
# ───────────────────────────────────────────────────────────────────────────
VITE_CONTACT_EMAIL=JimBoZen@proton.me

# ───────────────────────────────────────────────────────────────────────────
# 🤖 AI Assistant - Cloudflare Workers AI (REQUIRED FOR CHAT)
# ───────────────────────────────────────────────────────────────────────────
# Used by: Quick Chat Bar on WelcomePage, /admin-ai panel
# Get keys: https://dash.cloudflare.com → Account → API Tokens
# Cost: FREE tier (10,000 neurons), then $0.011/1000 neurons
# Models: Llama 3.2 1B/3B, Gemma 7B/12B (multilingual, Polish support)
#
VITE_CLOUDFLARE_ACCOUNT_ID=your_account_id_here
VITE_CLOUDFLARE_API_TOKEN=your_api_token_here

# ───────────────────────────────────────────────────────────────────────────
# 🎬 TMDB - The Movie Database API (RECOMMENDED - FREE)
# ───────────────────────────────────────────────────────────────────────────
# Used by: Movie/TV show metadata, posters, ratings
# Get key: https://www.themoviedb.org/settings/api
# Cost: FREE (1,000 requests/day)
# Required: Create account → Settings → API → Request API Key → Developer
#
VITE_TMDB_API_KEY=your_tmdb_api_key_here

# ───────────────────────────────────────────────────────────────────────────
# 🔍 Search Providers
# ───────────────────────────────────────────────────────────────────────────

# Kagi Search API (Premium quality, no ads, no tracking)
# Get key: https://kagi.com/settings?p=api
# Cost: $0.005 per search (requires Kagi Ultimate $25/mo or $300/yr)
VITE_KAGI_API_KEY=your_kagi_api_key_here

# Tavily Search API (AI-optimized search)
# Get key: https://tavily.com (sign up → API keys)
# Cost: FREE tier (1,000 searches/mo), then $0.002/search
VITE_TAVILY_API_KEY=your_tavily_api_key_here

# Brave Search API (Independent search, fallback)
# Get key: https://brave.com/search/api/
# Cost: FREE tier (2,000 queries/mo), then $0.005/query
VITE_BRAVE_API_KEY=your_brave_api_key_here

# ───────────────────────────────────────────────────────────────────────────
# 🧠 Large Language Models (AI Chat)
# ───────────────────────────────────────────────────────────────────────────

# Google Gemini API (Gemini 2.0 Flash, Pro)
# Get key: https://aistudio.google.com/apikey
# Cost: FREE tier (60 requests/min), then paid
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Anthropic Claude API (Claude 3.5 Sonnet, Opus)
# Get key: https://console.anthropic.com/settings/keys
# Cost: Pay-as-you-go (Claude 3.5 Sonnet: $3/1M input, $15/1M output tokens)
VITE_ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenRouter API (Universal gateway: GPT-4, Claude, Gemini, 200+ models)
# Get key: https://openrouter.ai/keys
# Cost: Per-model pricing (e.g., GPT-4o: $2.50/1M input, $10/1M output)
VITE_OPENROUTER_API_KEY=your_openrouter_api_key_here

# Meta Llama API (via Groq, Together AI, or Replicate)
# Groq: https://console.groq.com/keys (FREE tier, fast inference)
# Together AI: https://api.together.xyz/settings/api-keys
# Replicate: https://replicate.com/account/api-tokens
VITE_LLAMA_API_KEY=your_llama_api_key_here

# Hugging Face Inference API (Open-source models)
# Get token: https://huggingface.co/settings/tokens
# Cost: FREE for public models, paid for Pro/Enterprise features
VITE_HUGGINGFACE_API_KEY=your_huggingface_token_here

# ───────────────────────────────────────────────────────────────────────────
# 🎨 Optional Features
# ───────────────────────────────────────────────────────────────────────────

# Supabase (Database, Auth - if using persistent storage)
# Get keys: https://supabase.com/dashboard → Project Settings → API
VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# OpenAI API (GPT-4, GPT-4 Turbo, o1 models - if not using OpenRouter)
# Get key: https://platform.openai.com/api-keys
# Cost: Pay-as-you-go (GPT-4o: $2.50/1M input, $10/1M output tokens)
VITE_OPENAI_API_KEY=your_openai_api_key_here

# ═══════════════════════════════════════════════════════════════════════════
# 📋 Priority Setup Checklist
# ═══════════════════════════════════════════════════════════════════════════
#
# ✅ MUST HAVE (for core functionality):
# [ ] VITE_CLOUDFLARE_ACCOUNT_ID + VITE_CLOUDFLARE_API_TOKEN (AI chat)
# [ ] VITE_TMDB_API_KEY (FREE - movie/TV metadata)
#
# ⭐ RECOMMENDED (enhanced features):
# [ ] VITE_GEMINI_API_KEY or VITE_ANTHROPIC_API_KEY (better AI quality)
# [ ] VITE_TAVILY_API_KEY or VITE_KAGI_API_KEY (web search)
#
# 🎯 OPTIONAL (nice to have):
# [ ] VITE_OPENROUTER_API_KEY (access to 200+ models)
# [ ] VITE_BRAVE_API_KEY (search fallback)
# [ ] VITE_SUPABASE_* (persistent storage)
#
# ═══════════════════════════════════════════════════════════════════════════
# 🔗 Quick Links
# ═══════════════════════════════════════════════════════════════════════════
#
